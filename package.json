{
  "name": "bank-pension-system",
  "private": true,
  "workspaces": [
    "apps/api",
    "apps/admin",
    "apps/portal",
    "apps/mobile",
    "apps/desktop"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "npm --workspace apps/api run dev",
    "dev:admin": "npm --workspace apps/admin run dev",
    "dev:portal": "npm --workspace apps/portal run dev",
    "dev:desktop": "npm --workspace apps/desktop run electron:dev",
    "build": "npm --workspace apps/api run build && npm --workspace apps/admin run build && npm --workspace apps/portal run build",
    "setup": "npm install && npm --workspace apps/api run prisma:generate"
  },
  "dependencies": {
    "framer-motion": "^12.43.0"
  }
}

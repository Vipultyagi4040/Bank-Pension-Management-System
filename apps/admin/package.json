{
  "name": "@pension/admin",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "electron/dist/main.js",
  "scripts": {
    "dev": "vite",
    "web:dev": "vite",
    "desktop:dev": "npm run build:electron && concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "tsc -b && vite build",
    "web:build": "tsc -b && vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "desktop:build": "npm run build:electron && tsc -b && vite build && electron-builder --win --dir --config electron-builder.json",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.83.0",
    "axios": "^1.10.0",
    "framer-motion": "^12.43.0",
    "lucide-react": "^1.28.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.7.1",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.1.2",
    "electron": "43.2.0",
    "electron-builder": "^25.1.8",
    "typescript": "~5.8.3",
    "vite": "^7.0.6",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.bankpension.admin",
    "productName": "Bank Pension Admin",
    "directories": {
      "output": "out/desktop"
    },
    "files": [
      "dist/**/*",
      "electron/dist/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
